MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=waiting_list
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false
RATE_LIMIT_ENABLED=true
SSE_HEARTBEAT_SECONDS=15

# --- Solo para docker-compose (no las usa la app si corres uvicorn directo) ---
# MYSQL_ROOT_PASSWORD=cambia-esto      # obligatoria, sin valor por defecto a propósito
# API_PORT=8000                        # puerto publicado en el host
# SEED_ON_START=true                   # migra y siembra al arrancar el contenedor
# SEED_DEMO_QUEUE=true                 # incluye la cola de ejemplo de La Terraza Azul
# SEED_OPEN_24H=true                    # abre los 3 locales 24h (no es horario real; solo pruebas)
# SEED_PASSWORD=demo1234               # contraseña de los 3 usuarios (solo si son nuevos)
# WAITLIST_NETWORK=waitlist-net        # red compartida con el contenedor del frontend
